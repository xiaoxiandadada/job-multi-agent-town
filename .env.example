# Model provider: anthropic (default) or openai for a self-hosted
# OpenAI-compatible endpoint.
JOB_AGENT_PROVIDER=anthropic

# Claude via the official Anthropic SDK.
ANTHROPIC_API_KEY=replace-me
# Optional; only set when routing through a gateway.
# ANTHROPIC_BASE_URL=https://api.anthropic.com
JOB_AGENT_MODEL=claude-sonnet-5
# Judge 是最后一道防线，而且它的输出直接就是用户看到的答案：交叉核对、删掉无来源
# 断言需要真正的推理，所以和 Job Analyst 一样上 Opus。
JOB_AGENT_JUDGE_MODEL=claude-opus-5
# Job Analyst 用 Opus，因为它要把 JD 术语讲到能面试的深度。
# 注意这个 profile 还顺带决定输出预算（见 JOB_AGENT_KNOWLEDGE_MAX_OUTPUT_TOKENS）。
JOB_AGENT_KNOWLEDGE_MODEL=claude-opus-5
# 工具循环与受约束改写的角色（job_scout / material_builder / interview_coach）。
# 它们要的是指令遵循和工具可靠性，不是推理深度。
JOB_AGENT_RELIABLE_MODEL=claude-sonnet-5
# 全局思考深度兜底。每个角色可以用 roles.json 的 effort 字段单独覆盖，网页角色卡
# 也能改。留空表示不发送 output_config —— 这和发送 high 不是一回事：Haiku 4.5 会
# 直接拒绝 effort 参数，所以「不设置」必须是可表达的状态。
# JOB_AGENT_CLAUDE_EFFORT=medium
# JOB_AGENT_CLAUDE_THINKING=1
# Server-side web_search / web_fetch for roles whose tools include web_search.
# JOB_AGENT_CLAUDE_WEB_TOOLS=1
# JOB_AGENT_CLAUDE_SEARCH_MAX_USES=6
# JOB_AGENT_CLAUDE_FETCH_MAX_USES=6
# 输出被 max_tokens 截断时自动续写的轮数上限（pause_turn 共用这个预算）。
# JOB_AGENT_CLAUDE_MAX_CONTINUATIONS=4
# 本地 Tool Executor 的 tool_use 往返上限。
# JOB_AGENT_CLAUDE_MAX_TOOL_ITERATIONS=6
# JOB_AGENT_CLAUDE_MAX_RETRIES=2
# JOB_AGENT_CLAUDE_PROMPT_CACHE=1
# 流式请求。auto（默认）= 先流式，遇到网关 SSE 事件不完整就本进程降级为非流式；
# 0 = 直接不流式（某些代理的 SSE 完全不可用时用）。
# JOB_AGENT_CLAUDE_STREAM=auto
# Search locale used for campus-recruiting queries.
# JOB_AGENT_SEARCH_COUNTRY=CN
# JOB_AGENT_SEARCH_TIMEZONE=Asia/Shanghai

# Legacy path: a user-supplied OpenAI-compatible endpoint.
# Only read when JOB_AGENT_PROVIDER=openai.
# JOB_AGENT_API_BASE=https://api.example.com/v1
# JOB_AGENT_API_KEY=replace-me
# Optional role-level model routing. A RoleSpec.model value configured through
# PATCH /api/roles/{role_id} takes precedence over these environment defaults.
# The variable name is derived from the role_id, so a renamed role needs a
# renamed variable — a stale one is silently ignored, not an error.
# JOB_AGENT_ROLE_MODEL_JOB_SCOUT=claude-sonnet-5
# JOB_AGENT_ROLE_MODEL_JOB_ANALYST=claude-opus-5
# JOB_AGENT_ROLE_MODEL_MATERIAL_BUILDER=claude-sonnet-5
# JOB_AGENT_ROLE_MODEL_INTERVIEW_COACH=claude-sonnet-5
# JOB_AGENT_ROLE_MODEL_JUDGE=claude-opus-5
# Shared by thinking and text on Claude 5, so keep it well above the old 800.
JOB_AGENT_MAX_OUTPUT_TOKENS=12000
# Job Analyst writes seven sections; it gets twice the budget.
JOB_AGENT_KNOWLEDGE_MAX_OUTPUT_TOKENS=24000
JOB_AGENT_ROLE_CONTEXT_MAX_CHARS=18000

# Feishu custom app credentials. Feishu is only the channel, not the model.
LARK_APP_ID=cli_xxx
LARK_APP_SECRET=replace-me

# Optional independent Feishu bot identities. Each role uses a separate
# Feishu custom app, while all identities share this same backend/runtime.
# The env var name is derived from the role_id, so renaming a role means
# renaming its two variables too.
# JOB_AGENT_FEISHU_ROLE_BOTS=job_scout,job_analyst,material_builder,interview_coach,judge
# LARK_ROLE_JOB_SCOUT_APP_ID=cli_xxx
# LARK_ROLE_JOB_SCOUT_APP_SECRET=replace-me
# LARK_ROLE_JOB_ANALYST_APP_ID=cli_xxx
# LARK_ROLE_JOB_ANALYST_APP_SECRET=replace-me
# LARK_ROLE_MATERIAL_BUILDER_APP_ID=cli_xxx
# LARK_ROLE_MATERIAL_BUILDER_APP_SECRET=replace-me
# LARK_ROLE_INTERVIEW_COACH_APP_ID=cli_xxx
# LARK_ROLE_INTERVIEW_COACH_APP_SECRET=replace-me
# LARK_ROLE_JUDGE_APP_ID=cli_xxx
# LARK_ROLE_JUDGE_APP_SECRET=replace-me

# Optional runtime settings.
JOB_AGENT_MAX_CONCURRENCY=4

# Always-on shift: roles that keep working between @mentions.
# The API server starts it via lifespan; `job-agent-watch` runs it standalone.
# Both take the same file lock, so running both never doubles the patrols.
JOB_AGENT_ALWAYS_ON=1
JOB_AGENT_ALWAYS_ON_ROLES=job_scout
JOB_AGENT_ALWAYS_ON_INTERVAL_SECONDS=900
JOB_AGENT_ALWAYS_ON_JITTER_SECONDS=120
# Heartbeat cadence; this is what lets the RPG town say "last worked N s ago".
JOB_AGENT_ALWAYS_ON_HEARTBEAT_SECONDS=30
JOB_AGENT_ALWAYS_ON_FIRST_DELAY_SECONDS=20
JOB_AGENT_ALWAYS_ON_MAX_BACKOFF_SECONDS=3600
# 单次巡检的超时。比 @ 一次的 45 秒宽得多：核实一个 JD 要搜索 + 抓页 + 两三轮工具。
JOB_AGENT_ALWAYS_ON_TIMEOUT_SECONDS=300

# 每日日报定时推送。和常驻巡检一样，API 进程和 `job-agent-watch` 都会尝试接管，
# 由同一把文件锁决定谁真的发，所以两个一起开也不会重复推。
JOB_AGENT_DAILY_PUSH=1
JOB_AGENT_DAILY_PUSH_AT=09:30
JOB_AGENT_DAILY_PUSH_TZ=Asia/Shanghai
# 定时器是轮询而不是睡到某一刻：合盖睡过 09:30 的那天醒来仍会补推。
# 超过这个小时数就算过期，当天不再推——早上的日报晚上十一点送到只是噪音。
JOB_AGENT_DAILY_PUSH_MAX_DELAY_HOURS=6
JOB_AGENT_DAILY_PUSH_POLL_SECONDS=120
# 推送失败后的退避间隔，在补推窗口内会一直重试。
JOB_AGENT_DAILY_PUSH_RETRY_SECONDS=600
# 定时推送默认发摘要；设为 1 则发完整日报。
# JOB_AGENT_DAILY_PUSH_FULL=0
# 当天没有人工日报时，各角色现场写一份的单节超时。
JOB_AGENT_DAILY_GENERATE_TIMEOUT_SECONDS=300

# Local tool executor. Used when the provider has no server-side web tools, and
# also whenever a role names list_tracked_jobs / fetch_url directly in its tools
# (the narrow grant — e.g. the judge gets fetch_url so it can verify a cited
# link, without list_tracked_jobs letting it introduce jobs nobody mentioned).
# Hosts from the job table are allowed automatically; add extras here.
# JOB_AGENT_FETCH_ALLOWED_DOMAINS=jobs.bytedance.com,campus.tencent.com
JOB_AGENT_FETCH_MAX_CHARS=12000
JOB_AGENT_FETCH_TIMEOUT_SECONDS=20
JOB_AGENT_FETCH_MAX_BYTES=2000000
# Production default. Set to asyncio only for baseline/A-B comparison.
JOB_AGENT_ORCHESTRATOR=langgraph
JOB_AGENT_FEISHU_MAX_CHARS=8000
JOB_AGENT_LOG_LEVEL=INFO
JOB_AGENT_DATA_DIR=./data/runtime
JOB_AGENT_PREPARE_DIR=/path/to/interview/prepare
# Optional override; otherwise the bot remembers the most recent chat.
# JOB_AGENT_FEISHU_CHAT_ID=oc_xxx
